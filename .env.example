# Example environment variables for Expo builds.
# Replace the placeholder values with your real production values before building.
# Do not commit real secrets or private keys.

EXPO_PUBLIC_API_URL=https://your-production-api.example
EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY
EXPO_PUBLIC_TRIP_SHARE_API_URL=https://your-production-api.example/api/trips/share
