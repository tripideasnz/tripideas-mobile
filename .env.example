# Local development configuration. Copy to .env.local (untracked) and fill in the map key.
#
# All three variables are REQUIRED. The app has no defaults: if one is missing it stops with an
# error naming the variable, instead of quietly talking to production.
#
# These are the INTEGRATION (staging) values, the safe default for development and testing.
# Do not point a development build at production. Production values live only in the EAS
# "production" environment; see docs/release-configuration.md for who gets what.
#
# After changing this file, restart Metro with a cleared cache (npx expo start --clear): Metro
# caches the old values otherwise.
#
# Do not commit real secrets or keys. The map key is a MapTiler key; ask the project owner for it.

EXPO_PUBLIC_API_URL=https://tripideas-api-integration-staging.up.railway.app
EXPO_PUBLIC_TRIP_SHARE_API_URL=https://staging.tripideas.nz/api/trips/share
EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=<YOUR_MAPTILER_KEY>
